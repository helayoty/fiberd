vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 32
  }
}

direction: right

classes: {
  actor: {
    style: {
      fill: "#FFFFFF"
      stroke: "#8C959F"
      stroke-width: 2
      border-radius: 10
      font-size: 18
      font-color: "#1F2328"
      bold: true
    }
  }
  agent: {
    style: {
      fill: "#DAFBE1"
      stroke: "#1A7F37"
      stroke-width: 2
      border-radius: 10
      font-size: 17
      font-color: "#1F2328"
      bold: true
    }
  }
  template: {
    style: {
      fill: "#FFF8C5"
      stroke: "#9A6700"
      stroke-width: 2
      border-radius: 10
      font-size: 17
      font-color: "#1F2328"
      bold: true
    }
  }
  fiber: {
    style: {
      fill: "#FBEFFF"
      stroke: "#8250DF"
      stroke-width: 2
      border-radius: 10
      font-size: 16
      font-color: "#1F2328"
    }
  }
  cold: {
    style: {
      stroke: "#0969DA"
      stroke-width: 2
      font-size: 15
      font-color: "#0969DA"
    }
  }
  warm: {
    style: {
      stroke: "#8250DF"
      stroke-width: 2
      font-size: 15
      font-color: "#8250DF"
    }
  }
}

cp: Control plane {class: actor}
caller: Caller {class: actor}

home: Home {
  style: {
    fill: "#F6F8FA"
    stroke: "#D0D7DE"
    stroke-width: 2
    border-radius: 14
    font-size: 18
    font-color: "#57606A"
    bold: true
  }

  agent: fiberd agent {class: agent}
  template: Warm template {class: template}

  fibers: "" {
    style: {
      fill: transparent
      stroke-width: 0
    }
    grid-columns: 1
    grid-gap: 16
    a: Fiber A {class: fiber}
    b: Fiber B {class: fiber}
    n: "+ N" {
      class: fiber
      style.stroke-dash: 4
    }
  }

  agent -> template: warm once {class: warm}
  template -> fibers: fork / restore {class: warm}
}

cp -> home.agent: 1  signed grant {class: cold}
home.agent -> cp: status {
  class: cold
  style.stroke-dash: 5
}
caller -> home.agent: 2  Clone {class: warm}
home.agent -> caller: 3  endpoint + fence {
  class: warm
  style.stroke-dash: 5
}
caller -> home.fibers.a: 4  connect {class: warm}
