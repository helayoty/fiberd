vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 32
  }
}

direction: down

classes: {
  step: {
    style: {
      fill: "#FFFFFF"
      stroke: "#8C959F"
      stroke-width: 2
      border-radius: 10
      font-size: 16
      font-color: "#1F2328"
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#F6F8FA"
      stroke: "#8C959F"
      stroke-width: 2
      font-size: 15
      font-color: "#1F2328"
    }
  }
  action: {
    style: {
      fill: "#FBEFFF"
      stroke: "#8250DF"
      stroke-width: 2
      border-radius: 10
      font-size: 16
      font-color: "#1F2328"
      bold: true
    }
  }
  ok: {
    shape: oval
    style: {
      fill: "#DAFBE1"
      stroke: "#1A7F37"
      stroke-width: 2
      font-size: 16
      font-color: "#1F2328"
      bold: true
    }
  }
  shed: {
    style: {
      fill: "#FFF8C5"
      stroke: "#9A6700"
      stroke-width: 2
      border-radius: 18
      font-size: 15
      font-color: "#1F2328"
      bold: true
    }
  }
  deferred: {
    style: {
      fill: "#DDF4FF"
      stroke: "#0969DA"
      stroke-width: 2
      border-radius: 18
      font-size: 15
      font-color: "#1F2328"
      bold: true
    }
  }
  reject: {
    style: {
      fill: "#FFEBE9"
      stroke: "#CF222E"
      stroke-width: 2
      border-radius: 18
      font-size: 15
      font-color: "#1F2328"
      bold: true
    }
  }
}

clone: Clone {
  shape: oval
  style: {
    fill: "#FFFFFF"
    stroke: "#1F2328"
    stroke-width: 2
    font-size: 16
    font-color: "#1F2328"
    bold: true
  }
}

verify: Verify grant {class: step}
budget: Rate budget {class: step}
state: Session state? {class: decision}
pressure: Under pressure? {class: decision}
lane: Grant lane healthy? {class: decision}

attach: ATTACH {class: action}
resume: RESUME {class: action}
create: CREATE {class: action}
runtime: Fork or restore {class: step}
done: Endpoint + fence {class: ok}

unauth: Unauthenticated {class: reject}
tiergap: FailedPrecondition {class: reject}
shed_budget: SHED {class: shed}
shed_pressure: SHED {class: shed}
shed_lane: SHED {class: shed}
deferred_lane: DEFERRED_FALLBACK {class: deferred}
deferred_runtime: DEFERRED_FALLBACK {class: deferred}

clone -> verify
verify -> unauth: invalid
verify -> budget: valid
budget -> shed_budget: exhausted
budget -> state: token

state -> attach: running
state -> resume: parked
state -> create: new
state -> lane: no capacity
state -> tiergap: parked, no checkpoint

lane -> deferred_lane: yes
lane -> shed_lane: no

attach -> done
resume -> pressure
create -> pressure
pressure -> shed_pressure: yes
pressure -> runtime: no
runtime -> deferred_runtime: fails
runtime -> done: ready
