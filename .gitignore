.DS_Store
.idea
.vscode

.cursor
.claude

/vendor
/out
/bin
/build

# Rust build output of the Hyperlight guest and helper
hack/hyperlight/*/target/

# Rust build output of the zygote library's core and its fuzz crate, and
# what cargo-fuzz leaves beside the seeds
sdk/c/template/core/target/
sdk/c/template/core/fuzz/target/
sdk/c/template/core/fuzz/artifacts/
sdk/c/template/core/fuzz/coverage/

# Binaries built at the repository root. Anchored, so cmd/fiberd and
# docker/fiberd are never ignored.
/fiberd

# go build output of the substrate example worker
examples/substrate/ateom-fiberd

# the Python SDK's in-place extension build, its packages and caches (sdk/python)
*.abi3.so
__pycache__/
*.egg-info/
sdk/python/build/
sdk/python/dist/
sdk/python/wheelhouse/
.pytest_cache/
.ruff_cache/

# The TypeScript client's dependencies, compiled output and package staging
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/typescript/.test-build/
sdk/typescript/*.tgz
sdk/typescript/LICENSE
sdk/typescript/NOTICE
