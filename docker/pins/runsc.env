# The gVisor runsc fiberd is built and tested against. Every image that
# installs runsc reads this file, so there is one pin (docker/fiberd,
# docker/kubernetes and docker/dev). It is sourced by sh, so keep it to
# plain NAME=value lines.
#
# To bump, set RUNSC_RELEASE to a release that has both an x86_64 and an
# aarch64 runsc, then copy both sums from that release's runsc.sha512
# files (https://storage.googleapis.com/gvisor/releases/release/<release>/<arch>/runsc.sha512).
# The build checks each download against these sums, not against the server.
RUNSC_RELEASE=20260817.0
RUNSC_SHA512_X86_64=84936438d583ec976800f464e75a83e1515f0890b451b9b4db219c4472b54ca9b106a6772ee683f1e64cce2128871d7637b14d800591f8451b8137f6c39fb2ef
RUNSC_SHA512_AARCH64=6394fd161a4af0dc9a2c29f75c3016d05275a55744f124e12023fa7666a9f161c68d6ce3803ad49205c6a7b5bee0ad2ccf48edff340db344fdafec678c788aa4
