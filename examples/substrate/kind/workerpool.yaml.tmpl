# A Substrate WorkerPool whose workers are fiberd homes: the only change
# from the counter demo's pool is the image. The class is `gvisor` and
# the workers run it: every actor is a fiber in its own runsc sandbox,
# restored from the template's sandbox image, with the worker's own runsc
# and rootfs. The capabilities Substrate grants the class are the ones
# this worker needs. With no configRef the pool follows the class's
# default SandboxConfig.
apiVersion: v1
kind: Namespace
metadata:
  name: ${ATESPACE}
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: ${POOL}
  namespace: ${ATESPACE}
  labels:
    workload: ${POOL}
spec:
  replicas: 2
  workerImage: ${IMAGE}
  sandboxClasses:
  - name: gvisor
  template:
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi
